<Window x:Class="GnirehtetSquad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gnirehtet Squad" Width="1200" Height="840" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource OnSurface}"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Карточка устройства -->
        <DataTemplate x:Key="DeviceTemplate">
            <Border Background="{StaticResource ScLow}" BorderBrush="{StaticResource OutlineVar}" BorderThickness="1"
                    CornerRadius="16" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="14" Background="{Binding IconBg}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{Binding IconFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding Serial}" Foreground="{StaticResource OnSurfaceVar}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Style="{StaticResource Chip}" Background="{Binding StateBg}">
                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateFg}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding ApkVisibility}">
                                <TextBlock Text="{Binding ApkText}" Foreground="{StaticResource OnPrimaryContainer}" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding BusyVisibility}" Background="{StaticResource WarnContainer}">
                                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Warn}" FontSize="11"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="360">
                        <Button Style="{StaticResource SmallTonal}" Tag="start" CommandParameter="{Binding Serial}" Click="DeviceAction_Click"
                                IsEnabled="{Binding CanStart}" ToolTip="Включить VPN на телефоне">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="VPN вкл"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallText}" Tag="stop" CommandParameter="{Binding Serial}" Click="DeviceAction_Click"
                                IsEnabled="{Binding CanAct}" ToolTip="Выключить VPN на телефоне">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Выкл"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallText}" Tag="{Binding InstallAction}" CommandParameter="{Binding Serial}" Click="DeviceAction_Click"
                                IsEnabled="{Binding CanAct}" Content="{Binding InstallText}" ToolTip="Установить gnirehtet.apk на телефон"/>
                        <Button Style="{StaticResource SmallText}" Tag="uninstall" CommandParameter="{Binding Serial}" Click="DeviceAction_Click"
                                IsEnabled="{Binding CanAct}" Content="Удалить" ToolTip="Удалить gnirehtet с телефона"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate">
            <Grid TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Foreground="{StaticResource OnSurfaceVar}"/>
                <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding TextBrush}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="ReadyRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- кровавое свечение в углу -->
        <Ellipse Width="900" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-380,-320,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#40E3001C" Offset="0"/>
                    <GradientStop Color="#00E3001C" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource OutlineVar}" BorderThickness="0,0,1,0">
                <Grid Margin="0,18,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Effect="{StaticResource RedGlow}" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/icon.ico" Width="52" Height="52"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,30,0,0">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Главная" IsChecked="True" Checked="Nav_Checked"/>
                        <Grid>
                            <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" Tag="&#xE8EA;" Content="Устройства" Checked="Nav_Checked"/>
                            <Border x:Name="DeviceBadge" Background="{StaticResource Primary}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,16,0" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="DeviceBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Журнал" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Настройки" Checked="Nav_Checked"/>
                    </StackPanel>
                    <Button Grid.Row="2" Style="{StaticResource BaseButton}" Padding="8" Click="Quit_Click" ToolTip="Остановить всё и выйти">
                        <StackPanel>
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource OnSurfaceVar}"/>
                            <TextBlock Text="Выход" FontSize="12" FontWeight="Normal" Margin="0,4,0,0" Foreground="{StaticResource OnSurfaceVar}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Grid Margin="28,22,28,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}">
                            <Run Text="Gnirehtet"/><Run Text=" Squad" Foreground="{StaticResource PrimaryHi}"/>
                        </TextBlock>
                        <TextBlock Text="Интернет компьютера на Android по USB — без root" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="StatusChip" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Padding="14,7"
                            BorderThickness="1" BorderBrush="{StaticResource Outline}" Background="{StaticResource ScLow}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource OnSurfaceVar}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Остановлен" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Главная ===== -->
                <ScrollViewer x:Name="PageHome" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,0,28,28">
                        <!-- Баннер обновления -->
                        <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16" Visibility="Collapsed"
                                BorderBrush="{StaticResource Outline}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource PrimaryHi}" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateTitle" Text="Доступно обновление" Style="{StaticResource Title}"/>
                                    <TextBlock x:Name="UpdateSub" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                                    <ProgressBar x:Name="UpdateProgress" Margin="0,8,0,0" Visibility="Collapsed" Maximum="100"/>
                                </StackPanel>
                                <Button x:Name="UpdateInstallBtn" Grid.Column="2" Style="{StaticResource FilledButton}" Content="Обновить" Click="UpdateInstall_Click" Margin="14,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Главная карточка -->
                        <Border Background="{StaticResource HeroBrush}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="28" Padding="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="PowerButton" Click="Power_Click" Cursor="Hand" Width="150" Height="150" Margin="0,0,28,0"
                                        FocusVisualStyle="{x:Null}" ToolTip="Запустить / остановить раздачу">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Ellipse x:Name="PowerGlow" Fill="#E3001C" Opacity="0.0" Margin="6">
                                            <Ellipse.Effect>
                                                <BlurEffect Radius="40"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="PowerDisc" StrokeThickness="2" Stroke="{StaticResource Outline}">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush x:Name="PowerFill" GradientOrigin="0.35,0.3" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75">
                                                    <GradientStop x:Name="PowerStop1" Color="#2A0D10" Offset="0"/>
                                                    <GradientStop x:Name="PowerStop2" Color="#120607" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="52"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryHi}"/>
                                    </Grid>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroTitle" Text="Раздача выключена" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HeroSub" Text="Подключите телефон по USB и нажмите кнопку питания." Style="{StaticResource Body}" Margin="0,6,0,16"/>
                                    <WrapPanel>
                                        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,10" CornerRadius="14" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock x:Name="StatUptime" Text="—" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="ВРЕМЯ РАБОТЫ" FontSize="10" Foreground="{StaticResource OnSurfaceVar}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,10" CornerRadius="14" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock x:Name="StatClients" Text="0" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="КЛИЕНТОВ" FontSize="10" Foreground="{StaticResource OnSurfaceVar}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,10" CornerRadius="14" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock x:Name="StatDevices" Text="0" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="УСТРОЙСТВ" FontSize="10" Foreground="{StaticResource OnSurfaceVar}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,10" CornerRadius="14" MinWidth="110">
                                            <StackPanel>
                                                <TextBlock x:Name="StatRestarts" Text="0" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="ПЕРЕЗАПУСКОВ" FontSize="10" Foreground="{StaticResource OnSurfaceVar}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="20" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ModeAll" Style="{StaticResource Segment}" GroupName="Mode" Checked="Mode_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE977;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Все устройства"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeOne" Style="{StaticResource Segment}" GroupName="Mode" Checked="Mode_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Одно устройство"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox x:Name="SerialCombo" Grid.Column="1" Width="240" Margin="12,0,0,0" Visibility="Collapsed"
                                              DisplayMemberPath="Label" SelectionChanged="SerialCombo_SelectionChanged"/>
                                    <Button x:Name="RestartBtn" Grid.Column="3" Style="{StaticResource OutlinedButton}" Click="Restart_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Перезапустить"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Устройства" Style="{StaticResource Title}"/>
                                    </StackPanel>
                                    <TextBlock Text="Определяются автоматически через adb. В режиме «Все устройства» VPN включается на каждом подключённом телефоне."
                                               Style="{StaticResource Body}" Margin="0,4,0,14"/>
                                    <ItemsControl x:Name="HomeDevices" ItemTemplate="{StaticResource DeviceTemplate}"/>
                                    <TextBlock x:Name="HomeNoDevices" Text="Телефонов не видно. Подключите кабель и включите «Отладку по USB»."
                                               Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Готовность" Style="{StaticResource Title}"/>
                                    </StackPanel>
                                    <TextBlock Text="Проверка всего, что нужно для работы." Style="{StaticResource Body}" Margin="0,4,0,16"/>
                                    <Grid Style="{StaticResource ReadyRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ReadyRelayIcon" Text="&#xE73E;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="gnirehtet relay" FontWeight="SemiBold"/>
                                            <TextBlock Text="Встроен в программу" Style="{StaticResource Body}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource ReadyRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ReadyApkIcon" Text="&#xE73E;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="gnirehtet.apk" FontWeight="SemiBold"/>
                                            <TextBlock Text="Будет установлен на телефон автоматически" Style="{StaticResource Body}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource ReadyRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ReadyAdbIcon" Text="&#xE73E;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Android Debug Bridge (adb)" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ReadyAdbText" Text="Поиск…" Style="{StaticResource Body}" FontSize="12"/>
                                            <Button x:Name="HomeDownloadPt" Style="{StaticResource TonalButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Click="DownloadPt_Click" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Скачать platform-tools"/>
                                                </StackPanel>
                                            </Button>
                                            <ProgressBar x:Name="HomePtProgress" Margin="0,10,0,0" Maximum="100" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Последние события" Style="{StaticResource Title}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource TextButton}" Content="Весь журнал" HorizontalAlignment="Right" Click="OpenLog_Click"/>
                                </Grid>
                                <Border Background="{StaticResource Bg}" CornerRadius="14" Margin="0,12,0,0" Padding="6" BorderBrush="{StaticResource OutlineVar}" BorderThickness="1">
                                    <ListBox x:Name="RecentLog" Height="180" Background="Transparent" BorderThickness="0"
                                             ItemTemplate="{StaticResource LogTemplate}" ItemContainerStyle="{StaticResource PlainListItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Устройства ===== -->
                <ScrollViewer x:Name="PageDevices" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,0,28,28">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Подключение" Style="{StaticResource Title}"/>
                                <TextBlock Text="Телефоны по USB видны сразу. По Wi-Fi: на телефоне включите «Отладку по Wi-Fi» (или выполните adb tcpip 5555 по кабелю) и введите адрес."
                                           Style="{StaticResource Body}" Margin="0,4,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WifiAddr" KeyDown="WifiAddr_KeyDown" ToolTip="Например, 192.168.1.10:5555"/>
                                    <Button Grid.Column="1" Style="{StaticResource TonalButton}" Margin="10,0,0,0" Click="WifiConnect_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Подключить"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource OutlinedButton}" Click="AdbRestart_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Перезапустить adb"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Устройства" Style="{StaticResource Title}"/>
                                <TextBlock Text="«VPN вкл» работает, когда relay запущен. APK ставится автоматически при первом включении."
                                           Style="{StaticResource Body}" Margin="0,4,0,14"/>
                                <ItemsControl x:Name="AllDevices" ItemTemplate="{StaticResource DeviceTemplate}"/>
                                <TextBlock x:Name="AllNoDevices" Text="Телефонов не видно. Подключите кабель, включите «Параметры разработчика → Отладка по USB» и подтвердите запрос на телефоне."
                                           Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Журнал ===== -->
                <Grid x:Name="PageLog" Grid.Row="1" Margin="28,0,28,28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="FltApp" Style="{StaticResource FilterChip}" Content="Программа" IsChecked="True" Click="Filter_Changed"/>
                            <CheckBox x:Name="FltInfo" Style="{StaticResource FilterChip}" Content="Info" IsChecked="True" Click="Filter_Changed"/>
                            <CheckBox x:Name="FltWarn" Style="{StaticResource FilterChip}" Content="Warn" IsChecked="True" Click="Filter_Changed"/>
                            <CheckBox x:Name="FltError" Style="{StaticResource FilterChip}" Content="Error" IsChecked="True" Click="Filter_Changed"/>
                            <CheckBox x:Name="FltDebug" Style="{StaticResource FilterChip}" Content="Debug" IsChecked="False" Click="Filter_Changed"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="10,0" MaxWidth="320" HorizontalAlignment="Stretch">
                            <TextBox x:Name="LogSearch" TextChanged="LogSearch_TextChanged" Padding="32,8,10,8"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource OnSurfaceVar}" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <CheckBox x:Name="AutoScroll" Style="{StaticResource FilterChip}" Content="Автопрокрутка" IsChecked="True" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource TextButton}" Click="LogCopy_Click" ToolTip="Скопировать видимые строки">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Click="LogSave_Click" ToolTip="Сохранить в файл">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Click="LogClear_Click" ToolTip="Очистить журнал">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="18" Padding="8" BorderBrush="{StaticResource OutlineVar}" BorderThickness="1">
                        <ListBox x:Name="FullLog" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ItemTemplate="{StaticResource LogTemplate}" ItemContainerStyle="{StaticResource PlainListItem}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Grid>

                <!-- ===== Настройки ===== -->
                <ScrollViewer x:Name="PageSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="28,0,28,28">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Сеть" Style="{StaticResource Title}"/>
                                <TextBlock Text="DNS-серверы для телефона" Style="{StaticResource Body}" Margin="0,12,0,6"/>
                                <TextBox x:Name="SetDns" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource SmallTonal}" Margin="0,0,6,6" Content="Cloudflare" Tag="1.1.1.1,1.0.0.1" Click="DnsPreset_Click"/>
                                    <Button Style="{StaticResource SmallTonal}" Margin="0,0,6,6" Content="Google" Tag="8.8.8.8,8.8.4.4" Click="DnsPreset_Click"/>
                                    <Button Style="{StaticResource SmallTonal}" Margin="0,0,6,6" Content="Quad9" Tag="9.9.9.9,149.112.112.112" Click="DnsPreset_Click"/>
                                    <Button Style="{StaticResource SmallTonal}" Margin="0,0,6,6" Content="AdGuard" Tag="94.140.14.14,94.140.15.15" Click="DnsPreset_Click"/>
                                    <Button Style="{StaticResource SmallTonal}" Margin="0,0,6,6" Content="Яндекс" Tag="77.88.8.8,77.88.8.1" Click="DnsPreset_Click"/>
                                    <Button Style="{StaticResource SmallTonal}" Margin="0,0,6,6" Content="Cloudflare + Google" Tag="1.1.1.1,8.8.8.8" Click="DnsPreset_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Маршруты через VPN (пусто — весь трафик), например 10.0.0.0/8,192.168.0.0/16" Style="{StaticResource Body}" Margin="0,12,0,6"/>
                                <TextBox x:Name="SetRoutes" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360"/>
                                <TextBlock Text="Порт relay (по умолчанию 31416)" Style="{StaticResource Body}" Margin="0,12,0,6"/>
                                <TextBox x:Name="SetPort" Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="adb" Style="{StaticResource Title}"/>
                                <TextBlock Text="Путь к adb.exe или папке platform-tools. Пусто — искать автоматически." Style="{StaticResource Body}" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SetAdbPath" Width="460"/>
                                    <Button Style="{StaticResource TonalButton}" Content="Обзор…" Margin="10,0,0,0" Click="BrowseAdb_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="SetAdbFound" Style="{StaticResource Body}" FontSize="12" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource TonalButton}" Click="DownloadPt_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Скачать platform-tools"/>
                                        </StackPanel>
                                    </Button>
                                    <ProgressBar x:Name="SetPtProgress" Width="200" Margin="14,0,0,0" Maximum="100" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Text="Поведение" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="SetAutoStart" Style="{StaticResource Switch}" Click="Switch_Click" Content="Запускать relay при открытии программы"/>
                                <CheckBox x:Name="SetAutoRestart" Style="{StaticResource Switch}" Click="Switch_Click" Content="Перезапускать relay, если он упал"/>
                                <CheckBox x:Name="SetStopDevices" Style="{StaticResource Switch}" Click="Switch_Click" Content="Выключать VPN на телефонах при остановке"/>
                                <CheckBox x:Name="SetKeepBg" Style="{StaticResource Switch}" Click="Switch_Click" Content="Работать в фоне после закрытия окна (значок в трее)"/>
                                <CheckBox x:Name="SetStartup" Style="{StaticResource Switch}" Click="Switch_Click" Content="Запускать вместе с Windows (в фоне, relay сразу)"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Text="Обновления" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="SetCheckUpd" Style="{StaticResource Switch}" Click="Switch_Click" Content="Проверять обновления на GitHub (при запуске и каждые 6 часов)"/>
                                <CheckBox x:Name="SetAutoUpd" Style="{StaticResource Switch}" Click="Switch_Click" Content="Устанавливать обновления автоматически"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CheckUpdBtn" Style="{StaticResource TonalButton}" Content="Проверить сейчас" Click="CheckUpdate_Click"/>
                                    <TextBlock x:Name="UpdStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Обслуживание" Style="{StaticResource Title}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource OutlinedButton}" Margin="0,0,10,0" Click="KillStale_Click" Content="Завершить зависшие процессы"/>
                                    <Button Style="{StaticResource OutlinedButton}" Click="OpenFolder_Click" Content="Открыть папку программы"/>
                                </WrapPanel>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Body}" FontSize="12" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource FilledButton}" Click="SaveSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Сохранить"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Content="Отменить изменения" Margin="10,0,0,0" Click="RevertSettings_Click"/>
                            <TextBlock x:Name="SaveStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Всплывающее сообщение -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" CornerRadius="14" Padding="18,12"
                Background="{StaticResource ScHighest}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Visibility="Collapsed"
                Effect="{StaticResource RedGlow}" MaxWidth="640">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13"/>
        </Border>
    </Grid>
</Window>
